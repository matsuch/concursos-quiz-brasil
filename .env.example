# ---------------------------------------------------------------------------
# Frontend (Vite) — valores públicos, embutidos no bundle
# ---------------------------------------------------------------------------
# Console do Neon -> projeto -> Auth -> Configuration
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<região>.aws.neon.tech/<db>/auth
# Console do Neon -> projeto -> Data API
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<região>.aws.neon.tech/<db>/rest/v1

# ---------------------------------------------------------------------------
# Vercel Functions (api/) — SEGREDOS, só no painel da Vercel, nunca no git
# ---------------------------------------------------------------------------
# Conexão como dono do banco: não passa por RLS, é o que permite à função
# escrever em notifications, que não tem policy de INSERT.
DATABASE_URL=postgresql://<usuario>:<senha>@<host>/<db>?sslmode=require
# Mesmo JWKS do Neon Auth, usado para verificar o JWT de quem chama a função
NEON_JWKS_URL=https://<endpoint>.neonauth.<região>.aws.neon.tech/<db>/auth/.well-known/jwks.json
OPENAI_API_KEY=sk-...
